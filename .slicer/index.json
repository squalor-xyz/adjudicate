  "epilogue": "",
  "goals": "dlog is a small CLI with a plain-text store that records project decisions as a loop: an agent asks, the owner decides in batches, and every later agent reads the decision. The goal and non-goal records below come from PROJECT.md. Every assumption in the catalog is pending owner confirmation (see the 'Confirm open decisions' item).",
  "non_goals": "",
  "catalog": {
    "next_id": 23,
    "id_prefix": "C",
    "id_width": 2,
    "records": [
      {
        "id": "C01",
        "kind": "goal",
        "title": "Capture open questions in one command",
        "body": "Capture open questions with options and a recommendation in one command (PROJECT.md Goals 1).",
        "status": "active",
        "reason": "",
        "successor": ""
      },
      {
        "id": "C02",
        "kind": "goal",
        "title": "One inbox for batch answering",
        "body": "Show every open question in one inbox so the owner can answer them in a batch (Goals 2).",
        "status": "active",
        "reason": "",
        "successor": ""
      },
      {
        "id": "C03",
        "kind": "goal",
        "title": "Record decisions with rationale",
        "body": "Record a decision with a rationale and a link to the question it answers (Goals 3).",
        "status": "active",
        "reason": "",
        "successor": ""
      },
      {
        "id": "C04",
        "kind": "goal",
        "title": "Supersede with history",
        "body": "Supersede a decision while keeping its history (Goals 4).",
        "status": "active",
        "reason": "",
        "successor": ""
      },
      {
        "id": "C05",
        "kind": "goal",
        "title": "Compact agent context export",
        "body": "Export the accepted decisions as compact, token-cheap context, optionally filtered by tag or scope (Goals 5).",
        "status": "active",
        "reason": "",
        "successor": ""
      },
      {
        "id": "C06",
        "kind": "goal",
        "title": "Check before asking",
        "body": "Let an agent ask \"has X been decided?\" (check) before it asks the owner (Goals 6).",
        "status": "active",
        "reason": "",
        "successor": ""
      },
      {
        "id": "C07",
        "kind": "goal",
        "title": "Plain text in the repo",
        "body": "Store everything as plain text in the repo: diffable, mergeable, reviewable in a PR (Goals 7).",
        "status": "active",
        "reason": "",
        "successor": ""
      },
      {
        "id": "C08",
        "kind": "goal",
        "title": "Lint the log",
        "body": "Lint the log: missing fields, dangling links, supersede cycles, conflicting accepted decisions on the same key (Goals 8).",
        "status": "active",
        "reason": "",
        "successor": ""
      },
      {
        "id": "C09",
        "kind": "non_goal",
        "title": "No hosted service, database server, or web UI",
        "body": "v1 non-goal (PROJECT.md Non-goals).",
        "status": "active",
        "reason": "",
        "successor": ""
      },
      {
        "id": "C10",
        "kind": "non_goal",
        "title": "No LLM calls",
        "body": "dlog is a store and a workflow; agents bring their own reasoning (v1 non-goal).",
        "status": "active",
        "reason": "",
        "successor": ""
      },
      {
        "id": "C11",
        "kind": "non_goal",
        "title": "No cryptographic enforcement of who decided",
        "body": "v1 non-goal; see the open decision on owner-only decide enforcement.",
        "status": "active",
        "reason": "",
        "successor": ""
      },
      {
        "id": "C12",
        "kind": "non_goal",
        "title": "Not a slicer replacement",
        "body": "Slicer tracks work; dlog tracks decisions. They link to each other by ID but neither depends on the other (v1 non-goal).",
        "status": "active",
